{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stationerydotcom",
  "main": "./worker.js",
  "compatibility_date": "2026-10-05",
  "routes": [
    {
      "pattern": "stationerydotcom.me",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "previews": {},
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "workers_dev": true
}
