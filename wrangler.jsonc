{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stationerydotcom",
  "main": "./worker.js",
  "compatibility_date": "2026-10-05",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "previews": {},
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
